table LATE_VS_RATING
	lineageTag: 12daa6aa-d2c5-452c-87cb-687c7857f1bf

	measure 'Cohort delivered orders' = SUM(LATE_VS_RATING[DELIVERED_ORDERS])
		formatString: #,0
		lineageTag: db76cce9-d6da-4b15-95d8-42c8d6210132

	measure 'Reviewed orders' = SUM(LATE_VS_RATING[REVIEWED_ORDERS])
		formatString: #,0
		lineageTag: 182db966-62ae-4cd9-b977-0dae047dc3cc

	measure 'Avg score' = DIVIDE(SUM(LATE_VS_RATING[SCORE_SUM]), SUM(LATE_VS_RATING[REVIEWED_ORDERS]))
		formatString: 0.0000
		lineageTag: e2e97b87-65b3-4b77-9ecd-a7343cd2b2a4

	measure 'Low score share' = DIVIDE(SUM(LATE_VS_RATING[LOW_SCORE_ORDERS]), SUM(LATE_VS_RATING[REVIEWED_ORDERS]))
		formatString: 0.00%
		lineageTag: 9571e518-2190-4c71-9abb-f856d2b86bdf

	measure 'Rated before arrival' = SUM(LATE_VS_RATING[REVIEWED_BEFORE_DELIVERY])
		formatString: #,0
		lineageTag: 620977b5-b6b7-4485-aec5-2553e70d9f41

	measure 'Avg score WRONG (average of averages)' = AVERAGE(LATE_VS_RATING[AVG_SCORE])
		formatString: 0.0000
		lineageTag: 83c6b47a-b8e6-441a-b046-c5125a041a7e

