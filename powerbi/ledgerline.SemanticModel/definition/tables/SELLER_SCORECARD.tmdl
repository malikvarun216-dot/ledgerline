table SELLER_SCORECARD
	lineageTag: 0a13294a-c6e9-440d-8315-d11a9badc4d2

	measure Seller-months = COUNTROWS(SELLER_SCORECARD)
		formatString: #,0
		lineageTag: 72160cf0-f10d-439d-8cd6-c9d84f4a3e81

	measure Sellers = DISTINCTCOUNT(SELLER_SCORECARD[SELLER_ID])
		formatString: #,0
		lineageTag: 4a152965-6b67-4e5e-8a9c-9d2ba0d0ae5d

	measure 'Seller late rate' = DIVIDE(SUM(SELLER_SCORECARD[LATE_ORDERS]), SUM(SELLER_SCORECARD[DELIVERED_ORDERS]))
		formatString: 0.00%
		lineageTag: 2f74260d-778c-4a74-8982-6bfc3e781665

	measure 'Seller avg score' = DIVIDE(SUM(SELLER_SCORECARD[SCORE_SUM]), SUM(SELLER_SCORECARD[REVIEWED_ORDERS]))
		formatString: 0.00
		lineageTag: aab4e0bc-2767-4939-8aa1-352ae2da7ef9

	measure 'Seller revenue' = SUM(SELLER_SCORECARD[REVENUE])
		formatString: #,0.00
		lineageTag: c3f3eca4-83c8-45e5-a512-0a588fb34aec

