table COMPLAINT_TRENDS
	lineageTag: 88c83c08-1fdb-4dbd-a9ff-5047138fdc78

	measure 'Review count' = SUM(COMPLAINT_TRENDS[REVIEWS])
		formatString: #,0
		lineageTag: 644175f0-7b67-4762-80e6-5151ffba3927

	measure 'Negative reviews' = CALCULATE(SUM(COMPLAINT_TRENDS[REVIEWS]), COMPLAINT_TRENDS[SENTIMENT] = "negative")
		formatString: #,0
		lineageTag: d41fe1f4-9067-4a8c-be39-7f9318fa5e5c

	measure 'Negative share' = DIVIDE([Negative reviews], [Review count])
		formatString: 0.00%
		lineageTag: e3502e31-089e-4da8-b2cd-031ab5321bd1

	measure 'Review avg score' = DIVIDE(SUM(COMPLAINT_TRENDS[SCORE_SUM]), SUM(COMPLAINT_TRENDS[REVIEWS]))
		formatString: 0.0000
		lineageTag: 8bf3e3d1-57ed-4d7d-99ea-bdc952e5a56d

