table DELIVERY_PROMISE
	lineageTag: 23114b8e-900d-4861-a403-66410a35dda1

	measure 'Delivered orders' = COUNTROWS(DELIVERY_PROMISE)
		formatString: #,0
		lineageTag: b5e2805e-a67f-4769-b17c-441868010791

	measure 'Late orders' = CALCULATE(COUNTROWS(DELIVERY_PROMISE), DELIVERY_PROMISE[IS_LATE] = TRUE())
		formatString: #,0
		lineageTag: fb973e99-5cb9-4dda-b7d1-bf4f07585ce3

	measure 'Late share' = DIVIDE([Late orders], [Delivered orders])
		formatString: 0.00%
		lineageTag: 08637417-c38d-48af-afca-ae376cc7d3be

	measure 'Avg promised days' = AVERAGE(DELIVERY_PROMISE[PROMISED_DAYS])
		formatString: 0.00
		lineageTag: 79e15fb8-d5b2-4110-8e2a-920fcd610fbc

	measure 'Avg actual days' = AVERAGE(DELIVERY_PROMISE[ACTUAL_DAYS])
		formatString: 0.00
		lineageTag: 829a02c8-24bd-46bf-a300-0cce74421a60

	measure 'Avg days late (late orders)' = CALCULATE(AVERAGE(DELIVERY_PROMISE[DAYS_LATE]), DELIVERY_PROMISE[IS_LATE] = TRUE())
		formatString: 0.00
		lineageTag: 8aae9792-07c1-46c8-8006-9e3c0e4be0ad

	measure 'Distinct customers' = DISTINCTCOUNT(DELIVERY_PROMISE[CUSTOMER_UNIQUE_ID])
		formatString: #,0
		lineageTag: 2e13c937-6f5c-4dac-ac8b-8c3cbc66a34b

