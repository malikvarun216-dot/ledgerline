model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DELIVERY_PROMISE","LATE_VS_RATING","SELLER_SCORECARD","COMPLAINT_TRENDS","CUSTOMER_CURRENT","DQ_DELIVERY_PROMISE","ReaderRole"]

annotation PBI_ProTooling = ["DevMode"]

ref table DELIVERY_PROMISE
ref table LATE_VS_RATING
ref table SELLER_SCORECARD
ref table COMPLAINT_TRENDS
ref table CUSTOMER_CURRENT
ref table DQ_DELIVERY_PROMISE

ref cultureInfo en-IN

