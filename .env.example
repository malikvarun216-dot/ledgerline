# ledgerline — environment template
#
# Copy to .env and fill in. .env is gitignored; .env.example is not.
#   cp .env.example .env
#
# Nothing here is needed for Session 1 — the generators write local JSONL and
# CSV by default. These become live in Session 2, when the cloud accounts exist.

# --- Confluent Cloud (Session 2) -------------------------------------------
# Cluster > API keys. The Schema Registry key is a SEPARATE credential from the
# cluster key; using the cluster key for the registry fails with a confusing 401.
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# --- AWS / S3 (Session 2) ---------------------------------------------------
# Landing zone for the nightly dimension dumps; Auto Loader reads this prefix.
AWS_REGION=us-east-1
LEDGERLINE_S3_BUCKET=
LEDGERLINE_S3_PREFIX=ledgerline

# --- Databricks (Session 2) -------------------------------------------------
# Cost guard, not a suggestion: every cluster gets 10-minute auto-terminate.
# A single node left running a week is ~$120 against a ~$22 project budget.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=
DATABRICKS_CATALOG=ledgerline

# --- Snowflake (Session 13) -------------------------------------------------
# Trial is 30 days from signup. The CALENDAR binds, not the credits.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=LEDGERLINE_WH
SNOWFLAKE_DATABASE=LEDGERLINE

# --- Kaggle (Session 1) -----------------------------------------------------
# Only needed if you prefer env vars to ~/.kaggle/kaggle.json.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
