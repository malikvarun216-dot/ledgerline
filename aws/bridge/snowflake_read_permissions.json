{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BridgeSilverObjectsRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::ledgerline-bridge-8176114c/silver/*"
    },
    {
      "Sid": "BridgeBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::ledgerline-bridge-8176114c"
    }
  ]
}
