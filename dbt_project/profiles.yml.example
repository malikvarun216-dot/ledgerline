# ledgerline — dbt connection profile. Copy to dbt_project/profiles.yml (gitignored).
# It holds no secret: every value comes from .env, which scripts/run_dbt.py loads before dbt starts.
#
#   Copy-Item dbt_project/profiles.yml.example dbt_project/profiles.yml

ledgerline:
  target: snowflake
  outputs:
    # Primary target. Signs in as the key-pair service user (no password, no MFA), as the
    # TRANSFORMER role only: it reads RAW and builds STAGING / SNAPSHOTS / GOLD, nothing else.
    snowflake:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      role: LEDGERLINE_TRANSFORMER
      warehouse: LEDGERLINE_WH
      database: LEDGERLINE
      schema: STAGING          # default only; every folder sets its own schema in dbt_project.yml
      threads: 4
      query_tag: "ledgerline:dbt"
      client_session_keep_alive: false

    # Slim CI (Session 16; decisions.md "dbt CI builds land in a database of their own"). Signs in
    # as the CI service user, role LEDGERLINE_CI_RUNNER: builds ONLY in LEDGERLINE_CI, in the one
    # schema the run names (DBT_CI_SCHEMA — generate_schema_name puts every model there), and
    # reads production for everything it did not build (--defer). It cannot write LEDGERLINE.
    ci:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_CI_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_CI_PRIVATE_KEY_PATH') }}"
      role: LEDGERLINE_CI_RUNNER
      warehouse: LEDGERLINE_WH
      database: LEDGERLINE_CI
      schema: "{{ env_var('DBT_CI_SCHEMA') }}"
      threads: 4
      query_tag: "ledgerline:dbt-ci"
      client_session_keep_alive: false

    # Second target (Session 28; decisions.md S28): Gold on Databricks, built while Snowflake's Gold
    # still exists to be compared with. Signs in as the `ledgerline-ci` service principal (OAuth
    # machine-to-machine: client id + secret from .env), on the one SQL warehouse, into the four
    # schemas the owner made (databricks/gold/dbt_target_setup.sql). It reads workspace.raw, the
    # same bridge files Snowpipe loads (scripts/dbx_raw.py).
    databricks:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') | replace('https://', '') | trim('/') }}"
      http_path: "{{ env_var('DATABRICKS_SQL_HTTP_PATH', '/sql/1.0/warehouses/e1b5287e7502261b') }}"
      auth_type: oauth
      client_id: "{{ env_var('DATABRICKS_CLIENT_ID') }}"
      client_secret: "{{ env_var('DATABRICKS_CLIENT_SECRET') }}"
      catalog: workspace
      schema: staging          # default only; every folder sets its own schema in dbt_project.yml
      threads: 4
